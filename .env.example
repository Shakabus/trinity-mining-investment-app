# Required application settings
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DB_NAME"
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_live_xxx"
CLERK_SECRET_KEY="sk_live_xxx"

# Security and operations
CRON_SECRET="replace-with-strong-random-secret"
# Optional previous key during rotation window.
CRON_SECRET_PREVIOUS=""
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Optional provider keys (server-only; never expose on client)
COINGECKO_API_KEY=""
# Optional override. Defaults to x-cg-demo-api-key.
COINGECKO_API_KEY_HEADER=""
# Optional override. Defaults to https://api.coingecko.com/api/v3
COINGECKO_API_BASE_URL=""
GOOGLE_TRANSLATE_API_KEY=""
